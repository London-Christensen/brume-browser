{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brume Setup",
  "version": "0.1.0",
  "identifier": "com.londonchristensen.brume.setup",

  "build": {
    "frontendDist": "ui"
  },

  "app": {
    "withGlobalTauri": true,

    "windows": [
      {
        "label": "main",
        "title": "Install Brume",
        "width": 600,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "center": true,

        "decorations": false,
        "transparent": true,
        "shadow": false,

        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": false,
    "icon": ["../brand/assets/ico/brume.ico"],
    "publisher": "London Christensen",
    "copyright": "Copyright (c) London Christensen"
  }
}
